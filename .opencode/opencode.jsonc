{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  "permissions": [
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "allow" },
    { "action": "read", "resource": ".env-*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git remote remove *", "effect": "deny" },
    { "action": "shell", "resource": "git remote add *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "pnpm --dir frontend run build:*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm --dir frontend run lint:check",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm run lint",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm --dir frontend run e2e",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm --dir frontend run local",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm --dir frontend run debug",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm run check-formatting",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm --dir frontend exec vue-tsc *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "pnpm --dir frontend exec playwright test *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "dotnet build backend/*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "dotnet test backend/*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "dotnet run --project backend/*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "dotnet watch --project backend/*",
      "effect": "allow",
    },
    { "action": "shell", "resource": "./backend/build", "effect": "allow" },
    { "action": "shell", "resource": "./backend/run", "effect": "allow" },
    { "action": "shell", "resource": "./backend/watch", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "whoami *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "touch *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~/*", "effect": "deny" },
    { "action": "shell", "resource": ":(){:|:&};:", "effect": "deny" },
    { "action": "skill", "resource": "backend-security", "effect": "allow" },
  ],
  "skills": ["./.skills"],
  "formatter": {
    "oxfmt": {
      "command": [
        "pnpm",
        "exec",
        "oxfmt",
        "--config",
        "./frontend/.oxfmtrc.json",
        "$FILE",
      ],
      "extensions": [".ts", ".js", ".mjs", ".cjs", ".json", ".vue"],
    },
    "csharpier": {
      "command": ["dotnet", "csharpier", "format", "$FILE"],
      "extensions": [".cs", ".cshtml"],
    },
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "**/node_modules/**",
      "frontend/dist/**",
      "frontend/coverage/**",
      "frontend/playwright-report/**",
      "frontend/test-results/**",
      "backend/**/bin/**",
      "backend/**/obj/**",
    ],
  },
}
